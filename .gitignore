# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]

# Scratch: the pipeline writes its working directory under the skill's parent,
# and pdf-writeback stages temporary PDFs here too.
tmp/

# Releases built by scripts/package_skill.py (archives + SHA256SUMS).
dist/

# Generated by scripts/setup_local_ocr.sh (it regenerates every file here, including the
# compiled visionocr helper). Run that script, or `batch_pipeline.py doctor`, to recreate them.
scripts/ocr-shims/

# Machine-local external paths (signature template, handwriting face, interpreters, OCR
# helpers). Per-machine by definition, so it must not travel with the skill; the committed
# template is config/defaults.example.json.
config/local.json

# The teacher's signature ink. It may live here for a single-machine setup (see
# assets/signature/README.md) but is never committed: it is a person's signature, not part of a
# distributable skill, and package_skill.py excludes it from archives for the same reason.
assets/signature/*.pdf

# Real student reports kept for regression runs. Excluded by default: they are 20 MB and
# carry students' names and ID numbers. Include them with:
#   git add -f 实验报告_测试样本
实验报告_测试样本/

# Host workspace scratch. The *documents* under .workbuddy/ are worth versioning — in
# particular 环境自检报告.md, which records the machine the skill was set up on, and the
# run_*.sh benchmark harnesses. The run output and ad-hoc probes are regenerable, so they stay
# out. Note this is a git-only decision: package_skill.py does not read .gitignore.
.workbuddy/*.log
.workbuddy/_tmp_scan.txt
.workbuddy/_check_uncapped.py
